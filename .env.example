PORT=3000
HOST=127.0.0.1

# Binding to 127.0.0.1 keeps the app local-only by default. Set HOST=0.0.0.0 only
# when you explicitly want the service exposed to other machines on your network.
# Remote exposure creates SSRF and proxy-abuse risk if untrusted clients can reach
# the server or if private-network provider access is enabled.
HOST=127.0.0.1

# This must remain disabled unless you intentionally allow private-network upstreams
# (for example, approved BDIX provider integrations). Private addresses are blocked
# by default to prevent arbitrary SSRF to internal services.
ALLOW_PRIVATE_NETWORKS=false

# Optional upstream override; see fourkdhhub.js.
FOURKDH_BASE=
